{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "types": ["node", "@playwright/test", "vite/client"],
    "skipLibCheck": true
  },
  "include": ["e2e", "playwright.config.ts"]
}
