-### mobile bottom bar
-
-```tsx
-if (isMobile) {
-  return (
-    <nav className="nav-rail nav-rail--mobile" aria-label={t("nav.ariaLabel")}>
-      {enabledItems.map(renderItem)}
-    </nav>
-  );
-}
