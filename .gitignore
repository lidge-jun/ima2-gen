*.pyc

# Nix build outputs
/result
/result-*

# TS build emit artifacts (generated by build:server / build:cli)
/server.js
/config.js
/lib/**/*.js
/routes/**/*.js
/bin/ima2.js
/bin/commands/**/*.js
/bin/lib/*.js
*.tgz

# Test experiment outputs (generated images)
tests/experiments/

# Runtime thumbnail/project cache
cache/

