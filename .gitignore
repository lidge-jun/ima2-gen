.env
.ima2/
.codexclaw/
node_modules
generated/
!ui/src/generated/
!ui/src/generated/providers.ts
.DS_Store
# Keep ad-hoc devlog output ignored, except the reviewed subscription-MCP plan.
devlog/*
!devlog/_plan/
devlog/_plan/*
!devlog/_plan/260715_subscription-mcp-providers/
!devlog/_plan/260715_subscription-mcp-providers/**
# 260821 transparent-background unit: track the write-up, not the 23MB of
# generated PNG evidence (kept locally under evidence/).
!devlog/_plan/260821_gpt_image2_transparent_background/
!devlog/_plan/260821_gpt_image2_transparent_background/*.md
devlog/_plan/260821_gpt_image2_transparent_background/evidence/
ui/dist/
ui/tsconfig.app.tsbuildinfo
ui/tsconfig.node.tsbuildinfo
ui/tsconfig.e2e.tsbuildinfo
ui/test-results/
ui/playwright-report/
__pycache__/
*.pyc

# Nix build outputs
/result
/result-*

# TS build emit artifacts (generated by build:server / build:cli)
/server.js
/config.js
/lib/**/*.js
/routes/**/*.js
/bin/ima2.js
/bin/commands/**/*.js
/bin/lib/*.js
*.tgz

# Test experiment outputs (generated images)
tests/experiments/

# Runtime thumbnail/project cache
cache/
